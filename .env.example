# Application
APP_NAME=Projeto Osiris
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_V1_PREFIX=/api/v1

# Database (local execution)
DATABASE_URL=postgresql+asyncpg://osiris:osiris@localhost:5432/osiris
DATABASE_ECHO=false

# Future integrations: never commit real credentials
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Authentication (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=
OWNER_BOOTSTRAP_ENABLED=false
OWNER_BOOTSTRAP_TOKEN=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email verification (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Osiris <onboarding@resend.dev>
EMAIL_DELIVERY_ENABLED=false

# Operational alerts (Discord webhook; keep this URL secret)
DISCORD_ALERT_WEBHOOK_URL=
OPERATIONAL_ALERT_COOLDOWN_SECONDS=300
OPERATIONAL_ALERT_TIMEOUT_SECONDS=5

SEED_DEMO_HISTORY=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECOVERY_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
# Set a supported Graph API version from your Meta app, for example vNN.0.
WHATSAPP_API_VERSION=
WHATSAPP_AUTH_TEMPLATE=osiris_booking_access
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
GOOGLE_CALENDAR_CREDENTIALS_PATH=
